# === Fournisseurs IA (côté serveur uniquement) ===
# GEMINI_API_KEY : injecté automatiquement dans l'environnement d'exécution.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI API (optionnel — laisser vide si non utilisé)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Ollama local / distant avec Qwen (optionnel — ex. http://ollama:11434)
OLLAMA_BASE_URL=""
OLLAMA_MODEL="qwen2.5-coder:7b"

# === Sécurité & Chiffrement ===
# Clé hexadécimale 32 octets (64 caractères) pour le chiffrement AES-256-GCM des identifiants DB
ENCRYPTION_MASTER_KEY=""
# Secret de signature des sessions HMAC-SHA256
SESSION_SECRET=""

# === Application ===
APP_URL="MY_APP_URL"
PORT="3000"
SQL_MAX_ROWS="200"
SQL_TIMEOUT_MS="5000"
